{
  "name": "nutrition-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "typecheck": "ngc -p tsconfig.app.json && tsc -p tsconfig.spec.json --noEmit",
    "format": "npm run format:prettier && npm run format:html",
    "format:prettier": "prettier --write .",
    "format:html": "html-beautify --replace \"src/**/*.html\"",
    "format:check": "prettier --check . && node scripts/check-html-format.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11.11.0 <12"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@auth0/auth0-angular": "^2.11.0",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/signals": "^21.1.1",
    "date-fns": "^4.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "js-beautify": "^1.15.4",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  }
}
